# Secure, multi-stage build of react2shell.
# ---- deps: install with a clean cache ----
FROM node:20-slim AS deps
WORKDIR /app
COPY react2shell-secure/package.json react2shell-secure/package-lock.json ./
RUN npm ci && npm cache clean --force

# ---- build: compile the standalone server ----
FROM node:20-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY react2shell-secure/ .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- runtime: distroless, non-root ----
FROM gcr.io/distroless/nodejs20-debian12 AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# align with manifest security context
COPY --from=build --chown=1000:1000 /app/.next/standalone ./
COPY --from=build --chown=1000:1000 /app/.next/static ./.next/static
COPY --from=build --chown=1000:1000 /app/public ./public

USER 1000
EXPOSE 3000
# distroless nodejs image's entrypoint is already `node`
CMD ["server.js"]
